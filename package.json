{
  "name": "the-test-tour",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "workspaces": [
    "site",
    "game"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=site",
    "build": "npm run build --workspace=site",
    "preview": "npm run preview --workspace=site",
    "check": "npm run check:types && npm run check:format && npm run check:lint && npm run check:copy && npm run check:style && npm run check:deps && npm run check:facts && npm run check:budgets && npm run check:dead && npm run check:dups && npm run check:build",
    "check:types": "npm run typecheck --workspace=game",
    "check:format": "prettier --check .",
    "check:lint": "eslint .",
    "check:copy": "node scripts/check-copy.mjs",
    "check:style": "node scripts/check-style.mjs",
    "check:deps": "node scripts/check-deps.mjs",
    "check:facts": "node scripts/check-facts.mjs",
    "check:budgets": "node scripts/check-budgets.mjs",
    "check:dead": "knip",
    "check:dups": "jscpd --config .jscpd.json .",
    "check:build": "npm run build --workspace=site",
    "format": "prettier --write .",
    "prepare": "git config core.hooksPath .githooks || true",
    "facts": "node scripts/generate-worker-facts.mjs",
    "check:release": "node scripts/check-copy.mjs --release",
    "test:devices": "playwright test"
  },
  "devDependencies": {
    "@lhci/cli": "0.16.1",
    "@playwright/test": "1.65.1",
    "@typescript-eslint/parser": "8.73.0",
    "eslint": "10.15.0",
    "eslint-plugin-astro": "3.2.1",
    "jscpd": "5.4.3",
    "knip": "6.47.0",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
