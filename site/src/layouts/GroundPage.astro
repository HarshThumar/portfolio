---
// One page shell for every drivable ground. The ground's data travels to the game as JSON
// on the canvas, because game/ must not import site/ content (docs/05).
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/game-ui.css';
import grounds from '../content/grounds.json';
import { BUILT_GROUNDS } from '../content/built-grounds';

interface Props {
  ground: { slug: string; name: string };
  /** 'hub' or a ground slug: where the visit starts. */
  start: string;
  /** Home page only: the kit-becomes-a-ball opening plays before the hub. */
  opening?: boolean;
  title: string;
}

const { ground, start, opening = false, title } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
// The whole tour is one game: every page carries all grounds and starts at its own scene.
const tour = { grounds, start, built: BUILT_GROUNDS, base, opening };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta
      name="description"
      content={`[[COPY: meta description for ${ground.name}, written by Harsh]]`}
    />
    <title>{title}</title>
  </head>
  <body>
    <a href={`${base}scorecard/`} class="skip-link">
      [[COPY: skip link to the Scorecard view]]
    </a>
    <div id="hud" class="hud"></div>
    <div
      id="loader"
      class="loader"
      role="progressbar"
      aria-label="[[COPY: loading label]]"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
    >
      <div class="loader-crease">
        <svg class="loader-ball" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
          <circle
            cx="12"
            cy="12"
            r="10.5"
            fill="var(--leather)"
            stroke="var(--ink)"
            stroke-width="1.5"
          ></circle>
          <path
            d="M7.6 2.6 Q12 12 7.6 21.4"
            fill="none"
            stroke="var(--cream)"
            stroke-width="1"
            stroke-dasharray="1.4 1"
          ></path>
          <path
            d="M10.4 1.8 Q14.8 12 10.4 22.2"
            fill="none"
            stroke="var(--cream)"
            stroke-width="1"
            stroke-dasharray="1.4 1"
          ></path>
        </svg>
      </div>
    </div>
    <canvas
      id="tour-canvas"
      data-tour={JSON.stringify(tour)}
      aria-label={`[[COPY: canvas label for ${ground.name}]]`}
    ></canvas>
    <div id="load-error" class="load-error" role="alert" hidden>
      <p>[[COPY: the 3D ground failed to load (designed error state, in the site's voice)]]</p>
      <a href={`${base}scorecard/`}>[[COPY: link to the Scorecard view]]</a>
    </div>
    <noscript>
      <div class="load-error">
        <p>[[COPY: this ground needs JavaScript]]</p>
        <a href={`${base}scorecard/`}>[[COPY: link to the Scorecard view]]</a>
      </div>
    </noscript>

    <script>
      const canvas = document.getElementById('tour-canvas');
      const loader = document.getElementById('loader');
      const onProgress = (p: number): void => {
        loader?.style.setProperty('--progress', String(p));
        loader?.setAttribute('aria-valuenow', String(Math.round(p * 100)));
        if (p >= 1) loader?.classList.add('done');
      };
      const showError = (): void => {
        loader?.remove();
        document.getElementById('load-error')?.removeAttribute('hidden');
      };
      if (canvas instanceof HTMLCanvasElement && canvas.dataset.tour) {
        const tour = JSON.parse(canvas.dataset.tour);
        import('game')
          .then(({ initGame }) => {
            onProgress(0.3);
            return initGame({ canvas, ...tour, onProgress });
          })
          .catch((error: unknown) => {
            console.error('[tour] game failed to start', error);
            showError();
          });
      }
    </script>
  </body>
</html>
