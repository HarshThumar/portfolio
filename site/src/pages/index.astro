---
// Until M2 builds the walkout intro and the map, the home page drops you at Lord's.
import GroundPage from '../layouts/GroundPage.astro';
import grounds from '../content/grounds.json';

const lords = grounds.find((ground) => ground.slug === 'lords');
if (!lords) throw new Error("grounds.json has no Lord's entry");
---

<GroundPage ground={lords} title="The Test Tour | Harsh Thumar" />
