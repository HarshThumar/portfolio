---
// The home page is the hub: Narendra Modi Stadium, Ahmedabad. M2 puts the opening in front of it.
import GroundPage from '../layouts/GroundPage.astro';
import grounds from '../content/grounds.json';

const hub = grounds.find((ground) => ground.slug === 'ahmedabad');
if (!hub) throw new Error('grounds.json has no Ahmedabad entry');
---

<GroundPage ground={hub} start="hub" title="The Test Tour | Harsh Thumar" />
