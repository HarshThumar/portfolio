---
import GroundPage from '../../layouts/GroundPage.astro';
import grounds from '../../content/grounds.json';

export function getStaticPaths() {
  // Only grounds whose scene exists get a page. M3 adds the other nine here.
  // (Kept inside: Astro runs getStaticPaths in its own scope.)
  const BUILT = new Set(['lords']);
  return grounds
    .filter((ground) => BUILT.has(ground.slug))
    .map((ground) => ({ params: { slug: ground.slug }, props: { ground } }));
}

const { ground } = Astro.props;
---

<GroundPage ground={ground} title={`${ground.name} | The Test Tour`} />
