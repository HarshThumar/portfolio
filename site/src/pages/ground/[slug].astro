---
import GroundPage from '../../layouts/GroundPage.astro';
import grounds from '../../content/grounds.json';
import { BUILT_GROUNDS } from '../../content/built-grounds';

export function getStaticPaths() {
  // Only grounds whose scene exists get a page. M3 adds the others to BUILT_GROUNDS.
  return grounds
    .filter((ground) => BUILT_GROUNDS.includes(ground.slug))
    .map((ground) => ({ params: { slug: ground.slug }, props: { ground } }));
}

const { ground } = Astro.props;
---

<GroundPage ground={ground} start={ground.slug} title={`${ground.name} | The Test Tour`} />
